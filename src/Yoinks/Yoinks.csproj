<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Yoinks</RootNamespace>
    <AssemblyName>Yoinks</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Yoinks.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- WinUI 3, unpackaged, ships everything it needs (no runtime installs for the user) -->
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <Version>1.0.0</Version>
    <Product>Yoinks</Product>
    <Company>Tamim Ahmed Rijan</Company>
    <Authors>Tamim Ahmed Rijan</Authors>
    <Description>Yoinks - paste a link, yoink the video</Description>
    <Copyright>Copyright (c) 2026 Tamim Ahmed Rijan</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Yoinks.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon-256.png" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Assets\AppIcon-512.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>

</Project>
