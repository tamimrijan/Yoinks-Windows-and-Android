<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Yoinks.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============ iOS-style glass, tuned per theme ============ -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="GlassBrush" TintColor="#FFFFFF" TintOpacity="0.45" TintLuminosityOpacity="0.55" FallbackColor="#EEF7F7FA" />
                    <AcrylicBrush x:Key="GlassStrongBrush" TintColor="#FFFFFF" TintOpacity="0.62" TintLuminosityOpacity="0.72" FallbackColor="#F5FFFFFF" />
                    <SolidColorBrush x:Key="GlassInnerBrush" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="GlassInnerHoverBrush" Color="#99FFFFFF" />
                    <LinearGradientBrush x:Key="GlassStrokeBrush" StartPoint="0,0" EndPoint="0.6,1">
                        <GradientStop Offset="0" Color="#E6FFFFFF" />
                        <GradientStop Offset="0.5" Color="#66FFFFFF" />
                        <GradientStop Offset="1" Color="#24000000" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="GlassHairlineBrush" Color="#14000000" />
                    <x:Double x:Key="BlobOpacity">0.55</x:Double>
                    <Color x:Key="BlobA">#FF7AA2</Color>
                    <Color x:Key="BlobB">#B18CFF</Color>
                    <Color x:Key="BlobC">#6CC4FF</Color>
                    <Color x:Key="BlobD">#7CF0C8</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush x:Key="GlassBrush" TintColor="#1C1C22" TintOpacity="0.38" TintLuminosityOpacity="0.42" FallbackColor="#E61E1E24" />
                    <AcrylicBrush x:Key="GlassStrongBrush" TintColor="#202028" TintOpacity="0.55" TintLuminosityOpacity="0.6" FallbackColor="#F2202028" />
                    <SolidColorBrush x:Key="GlassInnerBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="GlassInnerHoverBrush" Color="#24FFFFFF" />
                    <LinearGradientBrush x:Key="GlassStrokeBrush" StartPoint="0,0" EndPoint="0.6,1">
                        <GradientStop Offset="0" Color="#55FFFFFF" />
                        <GradientStop Offset="0.45" Color="#18FFFFFF" />
                        <GradientStop Offset="1" Color="#0AFFFFFF" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="GlassHairlineBrush" Color="#1FFFFFFF" />
                    <x:Double x:Key="BlobOpacity">0.42</x:Double>
                    <Color x:Key="BlobA">#FF375F</Color>
                    <Color x:Key="BlobB">#8E5CFF</Color>
                    <Color x:Key="BlobC">#0A84FF</Color>
                    <Color x:Key="BlobD">#30D1A0</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="GlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassStrongBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassInnerBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassInnerHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GlassStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="GlassHairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <x:Double x:Key="BlobOpacity">0</x:Double>
                    <Color x:Key="BlobA">#000000</Color>
                    <Color x:Key="BlobB">#000000</Color>
                    <Color x:Key="BlobC">#000000</Color>
                    <Color x:Key="BlobD">#000000</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- let Mica + the ambient glow show through the navigation chrome -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

            <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF375F" />
                <GradientStop Offset="0.5" Color="#AF52DE" />
                <GradientStop Offset="1" Color="#0A84FF" />
            </LinearGradientBrush>

            <!-- big frosted panel (iOS sheet / widget look) -->
            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="24" />
            </Style>

            <!-- Windows 11 Settings-style row, frosted -->
            <Style x:Key="GlassRowStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="20,14" />
                <Setter Property="MinHeight" Value="68" />
            </Style>

            <Style x:Key="ChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassInnerBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Padding" Value="12,5" />
            </Style>

            <Style x:Key="PillAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Padding" Value="22,9" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="40" />
            </Style>

            <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Padding" Value="18,8" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Background" Value="{ThemeResource GlassInnerBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="4,24,0,8" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
