<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Yoinks.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Yoinks.Controls"
    xmlns:services="using:Yoinks.Services"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
    </Page.KeyboardAccelerators>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ContentPanel" Spacing="0">

            <InfoBar x:Name="ToolsBar" IsOpen="False" IsClosable="False" Severity="Warning" Margin="0,0,0,16"
                     Title="Yoinks needs a quick repair" Message="yt-dlp, the engine that does the downloading, was not found.">
                <InfoBar.ActionButton>
                    <Button Content="Open Settings" Click="OpenSettings_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- hero -->
            <StackPanel HorizontalAlignment="Center" Spacing="14" Margin="0,18,0,26">
                <Button x:Name="LogoButton" Click="Logo_Click" Background="Transparent" BorderThickness="0" Padding="8"
                        HorizontalAlignment="Center" ToolTipService.ToolTip="Home" AutomationProperties.Name="Yoinks home">
                    <controls:PixelLogo x:Name="Logo" CellSize="11" />
                </Button>
                <TextBlock Text="yoink any video. paste. yoink. done." HorizontalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                <ItemsControl x:Name="SiteChips" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Style="{StaticResource ChipStyle}" Padding="10,3">
                                <TextBlock Text="{x:Bind}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- the glass sheet everything happens in -->
            <Border x:Name="Sheet" Style="{StaticResource GlassCardStyle}" Background="{ThemeResource GlassStrongBrush}" CornerRadius="26" Padding="26,24">
                <Grid>
                    <!-- 1. paste a link -->
                    <StackPanel x:Name="InputPanel" Spacing="12">
                        <TextBlock Text="Paste a link" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,0,0,0" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox x:Name="UrlBox" PlaceholderText="https://youtube.com/watch?v=..." FontSize="15"
                                            QueryIcon="Link" CornerRadius="12" MinHeight="40" VerticalAlignment="Center"
                                            TextChanged="UrlBox_TextChanged" QuerySubmitted="UrlBox_QuerySubmitted"
                                            GotFocus="UrlBox_GotFocus" AutomationProperties.Name="Video link" />
                            <Button x:Name="YoinkButton" Grid.Column="1" Style="{StaticResource PillAccentButtonStyle}" Click="Yoink_Click"
                                    MinWidth="120" MinHeight="40" AutomationProperties.Name="Yoink">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="Yoink" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- clipboard offer / warnings -->
                        <Border x:Name="ClipboardChip" Style="{StaticResource ChipStyle}" HorizontalAlignment="Left" Padding="6,4,14,4" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="PasteClipboard_Click" Style="{StaticResource PillAccentButtonStyle}" Padding="12,3" MinHeight="26" FontSize="12">
                                    <TextBlock Text="Paste" />
                                </Button>
                                <TextBlock x:Name="ClipboardText" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="440"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="WarningText" Visibility="Collapsed" Margin="6,0,0,0" FontSize="12"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="SaveToText" Margin="6,2,0,0" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>

                    <!-- 2. probing -->
                    <Grid x:Name="ProbingPanel" Visibility="Collapsed" ColumnSpacing="18" MinHeight="120">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing IsActive="True" Width="44" Height="44" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Style="{StaticResource ChipStyle}" Padding="10,2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon x:Name="ProbePlatformIcon" Glyph="&#xE774;" FontSize="12" />
                                        <TextBlock x:Name="ProbePlatform" Text="YouTube" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="ProbeStatus" Text="fetching video info..." Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="ProbeUrl" Style="{StaticResource SecondaryTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Cancel" Style="{StaticResource PillButtonStyle}" Click="Cancel_Click" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 3. pick a format -->
                    <Grid x:Name="PickingPanel" Visibility="Collapsed" ColumnSpacing="24" RowSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PickLeftCol" Width="*" />
                            <ColumnDefinition x:Name="PickRightCol" Width="320" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="PickInfo" Spacing="12">
                            <Border CornerRadius="16" BorderBrush="{ThemeResource GlassHairlineBrush}" BorderThickness="1" Background="{ThemeResource GlassInnerBrush}">
                                <Grid>
                                    <FontIcon Glyph="&#xE714;" FontSize="36" Opacity="0.35" />
                                    <Image x:Name="Thumb" Stretch="UniformToFill" MaxHeight="260" />
                                    <Border x:Name="DurationBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                            Background="#B0000000" CornerRadius="8" Padding="8,2" Visibility="Collapsed">
                                        <TextBlock x:Name="DurationText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Style="{StaticResource ChipStyle}" Padding="10,2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon x:Name="PickPlatformIcon" Glyph="&#xE774;" FontSize="12" />
                                        <TextBlock x:Name="PickPlatform" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="UploaderText" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PickChoices" Grid.Column="1" Spacing="10">
                            <Grid>
                                <TextBlock Text="Download" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <Button HorizontalAlignment="Right" Style="{StaticResource PillButtonStyle}" Padding="12,4" MinHeight="30" Click="Back_Click" AutomationProperties.Name="Back">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72B;" FontSize="11" />
                                        <TextBlock Text="Back" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ListView x:Name="ChoiceList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ChoiceList_ItemClick" Padding="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="CornerRadius" Value="12" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="services:DownloadChoice">
                                        <Border Background="{ThemeResource GlassInnerBrush}" BorderBrush="{ThemeResource GlassHairlineBrush}" BorderThickness="1"
                                                CornerRadius="12" Padding="14,10">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource BrandGradient}">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="White" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <FontIcon Grid.Column="2" Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>

                    <!-- 4. downloading -->
                    <StackPanel x:Name="DownloadingPanel" Visibility="Collapsed" Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="112" Height="63" CornerRadius="10" BorderBrush="{ThemeResource GlassHairlineBrush}" BorderThickness="1" Background="{ThemeResource GlassInnerBrush}">
                                <Image x:Name="DlThumb" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="DlTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                                <TextBlock x:Name="DlChoice" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <TextBlock x:Name="DlPercent" Text="0%" FontSize="40" FontWeight="SemiBold" />
                            <TextBlock x:Name="DlPart" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8" Style="{StaticResource SecondaryTextStyle}" />
                        </Grid>
                        <ProgressBar x:Name="DlBar" Minimum="0" Maximum="100" Height="8" CornerRadius="4" />
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing x:Name="DlSpinner" IsActive="False" Width="16" Height="16" />
                                <TextBlock x:Name="DlMeta" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Content="Cancel" Style="{StaticResource PillButtonStyle}" Click="Cancel_Click" />
                        </Grid>
                    </StackPanel>

                    <!-- 5. done -->
                    <StackPanel x:Name="DonePanel" Visibility="Collapsed" Spacing="14" HorizontalAlignment="Center" Padding="0,8,0,4">
                        <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource BrandGradient}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="White" />
                        </Border>
                        <TextBlock Text="Yoinked!" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="DoneFile" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" MaxWidth="560" />
                        <TextBlock x:Name="DoneFolder" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource SecondaryTextStyle}" MaxWidth="560" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Style="{StaticResource PillAccentButtonStyle}" Click="OpenFile_Click" AutomationProperties.Name="Play">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="13" />
                                    <TextBlock Text="Play" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillButtonStyle}" Click="ShowInFolder_Click" AutomationProperties.Name="Show in folder">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE838;" FontSize="13" />
                                    <TextBlock Text="Show in folder" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillButtonStyle}" Click="Another_Click" AutomationProperties.Name="Yoink another">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                                    <TextBlock Text="Yoink another" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- 6. error -->
                    <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Spacing="12" HorizontalAlignment="Center" Padding="0,8,0,4">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE783;" FontSize="28" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </Border>
                        <TextBlock Text="Couldn't yoink that" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ErrorText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Style="{StaticResource PillAccentButtonStyle}" Content="Try again" Click="Retry_Click" />
                            <Button Style="{StaticResource PillButtonStyle}" Content="Back" Click="Back_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- recent -->
            <Grid x:Name="RecentHeader" Margin="4,28,0,8">
                <TextBlock Text="Recent yoinks" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <HyperlinkButton HorizontalAlignment="Right" Content="See all" Click="SeeAll_Click" />
            </Grid>
            <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:HistoryEntry">
                        <Border Style="{StaticResource GlassRowStyle}" MinHeight="0" Padding="12,10" Margin="0,0,0,6">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="72" Height="40" CornerRadius="8" Background="{ThemeResource GlassInnerBrush}">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{x:Bind Platform}" /><Run Text="  ·  " /><Run Text="{x:Bind Choice}" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource PillButtonStyle}" Padding="10,4" MinHeight="30" Tag="{x:Bind FilePath}" Click="RecentOpen_Click"
                                        ToolTipService.ToolTip="Play">
                                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
