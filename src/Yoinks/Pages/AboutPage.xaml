<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Yoinks.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Yoinks.Controls"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="LinkIcon" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ContentPanel">
            <TextBlock Text="About" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,16" />

            <!-- app banner: glass over the brand gradient -->
            <Grid CornerRadius="24" Background="{StaticResource BrandGradient}">
                <Border Background="#22FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="24" Padding="28,26">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="96" Height="96" CornerRadius="24" Background="#33FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1">
                            <Image Source="ms-appx:///Assets/AppIcon-256.png" Width="76" Height="76" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Yoinks" FontSize="34" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="yoink any video. paste. yoink. done." FontSize="15" Foreground="White" Opacity="0.92" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Border Background="#33FFFFFF" CornerRadius="999" Padding="10,3">
                                    <TextBlock x:Name="VersionText" Text="Version 1.0.0" FontSize="12" Foreground="White" />
                                </Border>
                                <Border Background="#33FFFFFF" CornerRadius="999" Padding="10,3">
                                    <TextBlock Text="Windows 10 / 11" FontSize="12" Foreground="White" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- creator -->
            <TextBlock Text="Made by" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource GlassCardStyle}" Padding="24,22">
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="92" Height="92" CornerRadius="46" Padding="3" Background="{StaticResource BrandGradient}" VerticalAlignment="Center">
                        <PersonPicture x:Name="Avatar" DisplayName="Tamim Ahmed Rijan" Width="86" Height="86" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Tamim Ahmed Rijan" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Developer of Yoinks for Windows" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Margin="0,4,0,10" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="made with " /><Run Text="&#x2665;" Foreground="#FF375F" /><Run Text=" and way too much caffeine" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource PillAccentButtonStyle}" Click="GitHub_Click" ToolTipService.ToolTip="github.com/tamimrijan">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE943;" FontSize="14" />
                                    <TextBlock Text="GitHub" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillButtonStyle}" Click="Instagram_Click" ToolTipService.ToolTip="instagram.com/tamim_ahmed_rijan">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE722;" FontSize="14" Foreground="#E1306C" />
                                    <TextBlock Text="Instagram" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- links -->
            <TextBlock Text="Find me" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel Spacing="6">
                <Border Style="{StaticResource GlassRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource LinkIcon}" Background="#24292F">
                            <FontIcon Glyph="&#xE943;" FontSize="18" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="GitHub" FontWeight="SemiBold" />
                            <TextBlock Text="github.com/tamimrijan" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="2" Content="Open profile" NavigateUri="https://github.com/tamimrijan" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource GlassRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource LinkIcon}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#FEDA75" />
                                    <GradientStop Offset="0.35" Color="#FA7E1E" />
                                    <GradientStop Offset="0.65" Color="#D62976" />
                                    <GradientStop Offset="1" Color="#4F5BD5" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <FontIcon Glyph="&#xE722;" FontSize="18" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Instagram" FontWeight="SemiBold" />
                            <TextBlock Text="@tamim_ahmed_rijan" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="2" Content="Follow" NavigateUri="https://www.instagram.com/tamim_ahmed_rijan/" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource GlassRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource LinkIcon}" Background="{StaticResource BrandGradient}">
                            <FontIcon Glyph="&#xE943;" FontSize="18" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Source code, updates and bug reports" FontWeight="SemiBold" />
                            <TextBlock Text="github.com/tamimrijan/yoinks-windows" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="2" Content="Open repo" NavigateUri="https://github.com/tamimrijan/yoinks-windows" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- credits -->
            <TextBlock Text="Credits" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource GlassCardStyle}" Padding="22,18">
                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Based on " /><Hyperlink NavigateUri="https://github.com/pablostanley/yoinks">yoinks</Hyperlink><Run Text=" by Pablo Stanley (MIT), the terminal app this desktop version is built from. The pixel wordmark is his." />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Downloads by " /><Hyperlink NavigateUri="https://github.com/yt-dlp/yt-dlp">yt-dlp</Hyperlink><Run Text=" (Unlicense), merging by " /><Hyperlink NavigateUri="https://ffmpeg.org">FFmpeg</Hyperlink><Run Text=" (GPL), YouTube support by " /><Hyperlink NavigateUri="https://deno.com">Deno</Hyperlink><Run Text=" (MIT)." />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" FontSize="13"
                               Text="Built with WinUI 3 and the Windows App SDK. Yoinks is a personal-archiving tool: only download what you have the right to keep, and be excellent to creators." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
