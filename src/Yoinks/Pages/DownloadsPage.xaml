<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Yoinks.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Yoinks.Pages"
    Background="Transparent">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ContentPanel" Spacing="6">
            <Grid Margin="0,0,0,14" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Downloads" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource PillButtonStyle}" Click="OpenFolder_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                        <TextBlock Text="Open folder" />
                    </StackPanel>
                </Button>
                <Button x:Name="ClearButton" Grid.Column="2" Style="{StaticResource PillButtonStyle}" Click="Clear_Click" VerticalAlignment="Center"
                        ToolTipService.ToolTip="Clear the list (your files stay where they are)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        <TextBlock Text="Clear list" />
                    </StackPanel>
                </Button>
            </Grid>

            <AutoSuggestBox x:Name="Search" PlaceholderText="Search your yoinks" QueryIcon="Find" CornerRadius="12" Margin="0,0,0,10"
                            TextChanged="Search_TextChanged" />

            <!-- empty state -->
            <Border x:Name="EmptyState" Style="{StaticResource GlassCardStyle}" Padding="32,40" Visibility="Collapsed">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="20" Background="{StaticResource BrandGradient}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE896;" FontSize="26" Foreground="White" />
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Text="Nothing yoinked yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyBody" Text="Videos you download show up here." Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <Button Content="Yoink something" Style="{StaticResource PillAccentButtonStyle}" HorizontalAlignment="Center" Margin="0,6,0,0" Click="GoHome_Click" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DownloadItem">
                        <Border Style="{StaticResource GlassRowStyle}" Padding="12" Margin="0,0,0,8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="128" Height="72" CornerRadius="10" Background="{ThemeResource GlassInnerBrush}" BorderBrush="{ThemeResource GlassHairlineBrush}" BorderThickness="1">
                                    <Grid>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" Opacity="0.4" />
                                        <Image Source="{Binding Entry.Thumbnail}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{x:Bind Entry.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Meta}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="File was moved or deleted" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind MissingVisibility}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PillAccentButtonStyle}" Padding="12,6" MinHeight="34" Tag="{x:Bind}" Click="Play_Click"
                                            IsEnabled="{x:Bind Exists}" ToolTipService.ToolTip="Play">
                                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                                    </Button>
                                    <Button Style="{StaticResource PillButtonStyle}" Padding="10,6" MinHeight="34" ToolTipService.ToolTip="More">
                                        <FontIcon Glyph="&#xE712;" FontSize="13" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="Show in folder" Tag="{x:Bind}" Click="Show_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Yoink again" Tag="{x:Bind}" Click="Again_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Copy link" Tag="{x:Bind}" Click="CopyLink_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Open original page" Tag="{x:Bind}" Click="OpenPage_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Remove from list" Tag="{x:Bind}" Click="Remove_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
