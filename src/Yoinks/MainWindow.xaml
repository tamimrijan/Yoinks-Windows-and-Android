<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Yoinks.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Yoinks">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ambient colour glow behind the frosted glass (the "wallpaper" iOS glass refracts) -->
        <Canvas x:Name="Ambient" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="{ThemeResource BlobOpacity}">
            <Ellipse x:Name="BlobA" Width="620" Height="620" Canvas.Left="-180" Canvas.Top="-220">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="{ThemeResource BlobA}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="BlobATransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BlobB" Width="680" Height="680" Canvas.Left="520" Canvas.Top="-260">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="{ThemeResource BlobB}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="BlobBTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BlobC" Width="720" Height="720" Canvas.Left="260" Canvas.Top="320">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="{ThemeResource BlobC}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="BlobCTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BlobD" Width="520" Height="520" Canvas.Left="-120" Canvas.Top="420">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="{ThemeResource BlobD}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="BlobDTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon-256.png" Width="18" Height="18" />
                <TextBlock Text="Yoinks" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Style="{StaticResource ChipStyle}" Padding="7,1" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionBadge" Text="v1.0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="1000"
            OpenPaneLength="232"
            IsSettingsVisible="True"
            SelectionChanged="Nav_SelectionChanged"
            DisplayModeChanged="Nav_DisplayModeChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Yoink" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloads" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="DownloadsBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
